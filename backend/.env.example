# Copy nothing by hand: `uv run python -m app.setup_db` writes backend/.env for this computer.
# The values below show the shape only (no real passwords).
DATABASE_URL=postgresql+psycopg://smet_app:CHANGE_ME@127.0.0.1:5432/smet
MIGRATION_DATABASE_URL=postgresql+psycopg://smet_owner:CHANGE_ME@127.0.0.1:5432/smet
TEST_DATABASE_URL=postgresql+psycopg://smet_app:CHANGE_ME@127.0.0.1:5432/smet_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://smet_owner:CHANGE_ME@127.0.0.1:5432/smet_test
# COOKIE_SECURE=true          # required once the app is served over HTTPS
# SESSION_IDLE_MINUTES=60
# RUN_WORKER_IN_API=true
